{
  "name": "portfolio-nuxt",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "nuxt build",
    "build:node": "NITRO_PRESET=node-server nuxt build",
    "start": "node .output/server/index.mjs",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare && simple-git-hooks",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "nuxt typecheck",
    "test": "vitest",
    "test:unit": "vitest --run",
    "test:e2e": "playwright test",
    "deploy": "pnpm build && wrangler deploy"
  },
  "dependencies": {
    "@nuxt/content": "^3.13.0",
    "@nuxt/image": "^2.0.0",
    "@nuxt/ui": "^4.7.1",
    "@vueuse/nuxt": "^14.3.0",
    "better-sqlite3": "^12.9.0",
    "nuxt": "^4.4.4",
    "nuxt-studio": "1.6.1",
    "tailwindcss": "^4.2.4",
    "vue": "^3.5.33",
    "vue-router": "^5.0.6",
    "zod": "^4.4.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@cloudflare/vitest-pool-workers": "^0.14.9",
    "@iconify-json/lucide": "^1.2.105",
    "@iconify-json/vscode-icons": "^1.2.47",
    "@nuxt/eslint": "^1.15.2",
    "@nuxt/fonts": "^0.14.0",
    "@nuxt/test-utils": "^4.0.3",
    "@nuxtjs/robots": "^6.0.8",
    "@nuxtjs/sitemap": "^8.0.15",
    "@playwright/test": "^1.59.1",
    "@takumi-rs/core": "^1.1.2",
    "@takumi-rs/wasm": "^1.1.2",
    "@types/node": "^25.6.0",
    "@vue/test-utils": "^2.4.10",
    "eslint": "^10.2.1",
    "eslint-plugin-tailwindcss": "^3.18.3",
    "eslint-plugin-tsdoc": "^0.5.2",
    "happy-dom": "^20.9.0",
    "lint-staged": "^16.4.0",
    "mdclint": "^0.1.2",
    "nuxt-og-image": "^6.4.9",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5",
    "vue-tsc": "^3.2.7",
    "wrangler": "^4.87.0"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*.{js,ts,vue,md}": [
      "eslint --fix"
    ]
  }
}
